# Groq API key -- free, get one at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# GitHub personal access token with repo + pull_request scopes
GITHUB_TOKEN=your_github_token_here

# Model to use for all agents (see https://console.groq.com/docs/models for current list).
# llama-3.1-8b-instant is fast and reliably available on all Groq accounts.
# If you want higher quality, try llama-3.3-70b-versatile or openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-20b

# Set to "true" to actually post the aggregated report as a PR comment
POST_TO_GITHUB=false
